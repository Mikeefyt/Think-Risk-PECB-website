# Enquiry form email settings. Copy this file to .env.local (or set these as environment
# variables in Hostinger) and fill in the real values. Never commit the real API key.

# Resend API key (resend.com -> API Keys), "Sending access" limited to pecbthinkrisk.com.au
RESEND_API_KEY=

# Sender address. Must be on the domain verified in Resend; it doesn't need to be a real mailbox.
ENQUIRY_FROM=enquiries@pecbthinkrisk.com.au

# Where enquiries are delivered (defaults to pecb@thinkrisk.com.au)
ENQUIRY_TO=pecb@thinkrisk.com.au
