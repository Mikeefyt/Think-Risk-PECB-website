# Enquiry form email settings. Copy this file to .env.local (or set these as environment
# variables in Hostinger) and fill in the real values. Never commit the real password.

# SMTP server of the mailbox that sends the enquiries, e.g. Hostinger Email: smtp.hostinger.com
SMTP_HOST=smtp.hostinger.com
# 465 (SSL) or 587 (STARTTLS)
SMTP_PORT=465
# Optional: "true" for SSL, "false" for STARTTLS. Defaults to true on port 465.
SMTP_SECURE=
# Mailbox login
SMTP_USER=noreply@thinkrisk.com.au
SMTP_PASS=

# Where enquiries are delivered (defaults to pecb@thinkrisk.com.au)
ENQUIRY_TO=pecb@thinkrisk.com.au
# Sender address (defaults to SMTP_USER; most providers require it to be that mailbox)
ENQUIRY_FROM=
